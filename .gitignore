# macOS junk
.DS_Store

# Python bytecode cache (skill scripts regenerate it on every run,
# e.g. render_leg_report.py importing the proof-campaign engine)
__pycache__/
*.pyc

# Local backups created by the sync process
*.bak
*.bak-*

# Skill-install backups (install.sh)
backups/

# Local agent/tool state
.codex/
.playwright-mcp/
.itr.db
.itr.db-*
.kgr-cache.json
claude/settings.json
# Cache Watch's per-person compaction rule for this checkout (compact: manual | auto | auto+summary)
.cache-watch
# Cache Watch's auto-compact handoffs, written into the working directory before a compaction
auto-compact-handoff-*.md

# Type declarations Claude Code writes beside a mod each time it loads it
claude/mods/*/.claude-plugin/types/

# Externally-sourced skills: present on disk so the symlinked global set keeps
# them, but not tracked here (forward-looking per-skill install will own these)
claude/skills/impeccable/

# Claude.ai skill-sync bucket (Anthropic-licensed, all rights reserved): kept on
# disk for the synced install, never versioned in this public repo
claude/skills/synced/
