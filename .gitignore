# macOS junk
.DS_Store

# Python bytecode cache (skill scripts regenerate it on every run,
# e.g. render_leg_report.py importing the proof-campaign engine)
__pycache__/
*.pyc

# Local backups created by the sync process
*.bak
*.bak-*

# Skill-install backups (install.sh)
backups/

# Local agent/tool state
.codex/
.playwright-mcp/
.itr.db
.itr.db-*
.kgr-cache.json
claude/settings.json

# Externally-sourced skills: present on disk so the symlinked global set keeps
# them, but not tracked here (forward-looking per-skill install will own these)
claude/skills/impeccable/
